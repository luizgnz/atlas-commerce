aws_region = "eu-central-1"

# owner_id / repo_id come from `gh api repos/OWNER/REPO --jq '{owner_id:.owner.id,repo_id:.id}'`
# Required for repos using GitHub's immutable OIDC subject claims.
github_repositories = [
  {
    name     = "Nitros64/atlas-commerce"
    owner_id = "50177640"
    repo_id  = "1230706878"
  },
  {
    name     = "luizgnz/atlas-commerce"
    owner_id = "101154230"
    repo_id  = "1323178047"
  },
]
